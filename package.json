{
  "name": "@fastpix/react-native-uploads",
  "version": "0.1.0",
  "description": "FastPix React Native Resumable Upload SDK",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "npm run --workspace react-native-uploads-example",
    "clean": "del-cli android/build test-example/android/build test-example/android/app/build test-example/ios/build lib",
    "prepare": "bob build && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "release": "release-it --only-version",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "fastpix",
    "upload",
    "uploader",
    "resumable-upload",
    "chunked-upload",
    "file-upload",
    "video-upload",
    "large-file-upload",
    "pause-resume",
    "upload-progress",
    "network-recovery",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FastPix/react-native-uploader.git"
  },
  "author": {
    "name": "FastPix-Dev",
    "email": "devs@fastpix.com",
    "url": "https://www.fastpix.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FastPix/react-native-uploader/issues"
  },
  "homepage": "https://github.com/FastPix/react-native-uploader#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.0",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "hermes-eslint": "^0.36.1",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.41.0",
    "release-it": "^20.2.1",
    "turbo": "^2.8.21",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "test-example"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/test-example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/dist/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "release-it",
      "eslint",
      "t"
    ],
    "version": "0.62.0"
  },
  "dependencies": {
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "axios": "^1.17.0",
    "react-native-blob-util": "^0.24.9"
  },
  "resolutions": {
    "strip-ansi": "6.0.1"
  }
}
