{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build:android": {
      "env": ["ANDROID_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "android",
        "!android/build",
        "src/**/*.ts",
        "src/**/*.tsx",
        "example/react-native/package.json",
        "example/react-native/android",
        "!example/react-native/android/.gradle",
        "!example/react-native/android/build",
        "!example/react-native/android/app/build"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "*.podspec",
        "ios",
        "src/**/*.ts",
        "src/**/*.tsx",
        "example/react-native/package.json",
        "example/react-native/ios",
        "!example/react-native/ios/build",
        "!example/react-native/ios/Pods"
      ],
      "outputs": []
    }
  }
}
